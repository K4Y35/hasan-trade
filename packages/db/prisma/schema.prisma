generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Language {
  EN
  BN
}

enum ThemeId {
  CLASSIC
  MODERN
  BOLD
}

enum ButtonStyle {
  SOLID
  OUTLINE
  SOFT
}

enum CardStyle {
  FLAT
  ELEVATED
  OUTLINED
}

enum StorageDriver {
  LOCAL
  MINIO
  S3
}

enum UserKind {
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SpecFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

enum RelatedProductType {
  RELATED
  UPSELL
  CROSS_SELL
}

enum StockMovementType {
  PURCHASE
  SALE
  POS_SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RESERVE
  RELEASE
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DEFECTIVE
  IN_TRANSIT
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum OrderChannel {
  WEB
  POS
  PHONE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProviderType {
  COD
  BKASH
  NAGAD
  CARD
  CASH
  BANK_TRANSFER
  DUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PosSaleStatus {
  COMPLETED
  RETURNED
  VOID
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  VOID
}

enum WarrantyClaimStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum MenuLocation {
  HEADER
  FOOTER
  MOBILE
  ACCOUNT
}

enum HomepageSectionType {
  HERO
  FEATURED_CATEGORIES
  FEATURED_PRODUCTS
  BANNERS
  BRANDS
  CUSTOM_HTML
}

enum CouponType {
  PERCENT
  FIXED
}

enum DueEntryType {
  SALE
  COLLECTION
  ADJUSTMENT
}

enum NotificationChannel {
  EMAIL
  SMS
}

// ---------------------------------------------------------------------------
// Store (singleton) + branches
// ---------------------------------------------------------------------------

/// One row per installation. Never add store_id to other tables.
model StoreSettings {
  id     String @id @default("default")
  name   String
  slug   String @unique
  legalName String?
  tagline     String?
  description String? @db.Text

  logoUrl        String? @db.VarChar(500)
  logoDarkUrl    String? @db.VarChar(500)
  faviconUrl     String? @db.VarChar(500)
  ogImageUrl     String? @db.VarChar(500)
  invoiceLogoUrl String? @db.VarChar(500)
  logoHeight     Int     @default(56)

  email    String?
  phone    String?
  whatsapp String?
  address  String? @db.Text
  hours    String? @db.VarChar(200)
  city     String?
  country  String  @default("BD")

  currency       String   @default("BDT")
  currencySymbol String   @default("৳")
  timezone       String   @default("Asia/Dhaka")
  language       Language @default(EN)
  locale         String   @default("en-BD")

  themeId         ThemeId     @default(CLASSIC)
  colorPrimary    String      @default("#0F172A")
  colorSecondary  String      @default("#F59E0B")
  colorAccent     String      @default("#0EA5E9")
  colorBackground String      @default("#FFFFFF")
  colorForeground String      @default("#0F172A")
  colorMuted      String      @default("#F1F5F9")
  fontSans        String      @default("Inter")
  fontHeading     String      @default("Inter")
  radius          String      @default("0.5rem")
  buttonStyle     ButtonStyle @default(SOLID)
  cardStyle       CardStyle   @default(ELEVATED)

  footerText      String? @db.Text
  copyrightText   String?
  privacyPolicy   String? @db.LongText
  termsOfService  String? @db.LongText
  returnPolicy    String? @db.LongText
  warrantyPolicy  String? @db.LongText
  invoicePrefix   String  @default("INV")
  invoiceFooter   String? @db.Text
  orderPrefix     String  @default("ORD")
  posReceiptFooter String? @db.Text

  taxRate            Decimal @default(0) @db.Decimal(5, 2)
  taxInclusive       Boolean @default(true)
  lowStockThreshold  Int     @default(5)
  allowGuestCheckout Boolean @default(true)
  allowCod           Boolean @default(true)

  storageDriver StorageDriver @default(LOCAL)

  metaTitle         String?
  metaDescription   String? @db.Text
  googleAnalyticsId String?
  facebookPixelId   String?

  facebookUrl  String? @db.VarChar(500)
  instagramUrl String? @db.VarChar(500)
  youtubeUrl   String? @db.VarChar(500)
  tiktokUrl    String? @db.VarChar(500)

  licenseKey     String?
  licensedDomain String?

  popupEnabled   Boolean   @default(false)
  popupTitle     String?   @db.VarChar(160)
  popupBody      String?   @db.Text
  popupImageUrl  String?   @db.VarChar(500)
  popupCtaLabel  String?   @db.VarChar(80)
  popupCtaUrl    String?   @db.VarChar(500)
  popupUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

model Branch {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  phone       String?
  email       String?
  address     String? @db.Text
  division    String?
  district    String?
  thana       String?
  city        String?
  hours       Json?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)
  fulfillsOnline Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  terminals       PosTerminal[]
  stockBalances   StockBalance[]
  stockLedger     StockLedger[]
  serials         SerialNumber[]
  purchaseOrders  PurchaseOrder[]
  transfersOut    StockTransfer[] @relation("TransferFrom")
  transfersIn     StockTransfer[] @relation("TransferTo")
  orders          Order[]
  posSessions     PosSession[]
  posSales        PosSale[]

  @@map("branches")
}

model PaymentProvider {
  id          String               @id @default(cuid())
  provider    PaymentProviderType  @unique
  displayName String
  enabled     Boolean              @default(false)
  sortOrder   Int                  @default(0)
  /// Non-secret display config (sandbox flag, public merchant number). Secrets stay in env.
  config      Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("payment_providers")
}

model NotificationProvider {
  id          String              @id @default(cuid())
  channel     NotificationChannel
  name        String
  enabled     Boolean             @default(false)
  config      Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([channel, name])
  @@map("notification_providers")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  kind         UserKind
  status       UserStatus @default(ACTIVE)
  email        String?    @unique
  phone        String?    @unique
  passwordHash String?
  name         String
  avatarUrl    String?    @db.VarChar(500)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  addresses          Address[]
  carts              Cart[]
  wishlistItems      WishlistItem[]
  compareItems       CompareItem[]
  orders             Order[]              @relation("CustomerOrders")
  staffOrders        Order[]              @relation("StaffOrders")
  posSessions        PosSession[]
  cashierSales       PosSale[]            @relation("CashierSales")
  customerSales      PosSale[]            @relation("CustomerSales")
  dueLedger          DueLedger[]
  warranties         Warranty[]
  auditLogs          AuditLog[]
  stockLedger        StockLedger[]
  purchaseOrders     PurchaseOrder[]
  createdTransfers   StockTransfer[]

  @@index([kind, status])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  group     String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(500)
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id             String  @id @default(cuid())
  userId         String
  label          String  @default("Home")
  name           String
  phone          String
  line1          String
  line2          String?
  thana          String?
  district       String
  division       String
  postalCode     String?
  country        String  @default("BD")
  isDefaultShip  Boolean @default(false)
  isDefaultBill  Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  diff       Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?  @db.VarChar(500)
  description String?  @db.Text
  website     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Category {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  path        String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metaTitle   String?
  metaDescription String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  ProductCategory[]
  menuItems MenuItem[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String        @id @default(cuid())
  name             String        @db.VarChar(500)
  slug             String        @unique
  sku              String?       @unique
  brandId          String?
  type             ProductType   @default(SIMPLE)
  status           ProductStatus @default(DRAFT)
  shortDescription String?       @db.Text
  description      String?       @db.LongText
  warrantyMonths   Int           @default(0)
  taxRate          Decimal?      @db.Decimal(5, 2)
  weightGrams      Int?
  isSerialized     Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?       @db.Text
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand        Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories   ProductCategory[]
  variants     ProductVariant[]
  images       ProductImage[]
  specs        ProductSpec[]
  relatedFrom  RelatedProduct[]  @relation("RelatedFrom")
  relatedTo    RelatedProduct[]  @relation("RelatedTo")
  wishlistItems WishlistItem[]
  compareItems  CompareItem[]
  warranties    Warranty[]

  @@index([brandId, status])
  @@index([status, publishedAt])
  @@fulltext([name, shortDescription, sku])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String?
  sku            String   @unique
  barcode        String?  @unique
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  weightGrams    Int?
  options        Json?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  stockBalances StockBalance[]
  stockLedger   StockLedger[]
  serials       SerialNumber[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  posSaleItems  PosSaleItem[]
  purchaseItems PurchaseOrderItem[]
  transferItems StockTransferItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String?
  mediaId   String?
  url       String  @db.VarChar(500)
  alt       String?
  sortOrder Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   MediaAsset?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model RelatedProduct {
  productId String
  relatedId String
  type      RelatedProductType @default(RELATED)

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId, type])
  @@map("related_products")
}

model SpecGroup {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields SpecField[]

  @@map("spec_groups")
}

model SpecField {
  id          String        @id @default(cuid())
  groupId     String
  name        String
  slug        String        @unique
  type        SpecFieldType @default(TEXT)
  unit        String?
  options     Json?
  filterable  Boolean       @default(false)
  comparable  Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  group    SpecGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  products ProductSpec[]

  @@index([groupId])
  @@map("spec_fields")
}

model ProductSpec {
  productId String
  fieldId   String
  value     String @db.VarChar(500)

  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  field   SpecField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([productId, fieldId])
  @@index([fieldId, value])
  @@map("product_specs")
}

model MediaAsset {
  id        String         @id @default(cuid())
  key       String         @unique @db.VarChar(500)
  url       String         @db.VarChar(500)
  driver    StorageDriver  @default(LOCAL)
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  alt       String?
  folder    String?
  createdAt DateTime       @default(now())

  productImages ProductImage[]

  @@index([folder])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// Cached on-hand. Never edit from the admin; update only with a ledger row.
model StockBalance {
  id        String   @id @default(cuid())
  branchId  String
  variantId String
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([branchId, variantId])
  @@index([variantId])
  @@map("stock_balances")
}

/// Append-only. Application code must never UPDATE or DELETE these rows.
model StockLedger {
  id            String             @id @default(cuid())
  branchId      String
  variantId     String
  quantity      Int
  balanceAfter  Int
  type          StockMovementType
  reason        String?
  unitCost      Decimal?           @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime           @default(now())

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, variantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_ledger")
}

model SerialNumber {
  id            String       @id @default(cuid())
  serial        String       @unique
  variantId     String
  branchId      String?
  status        SerialStatus @default(IN_STOCK)
  purchasedAt   DateTime?
  soldAt        DateTime?
  orderItemId   String?
  posSaleItemId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderItem   OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  posSaleItem PosSaleItem?   @relation(fields: [posSaleItemId], references: [id], onDelete: SetNull)
  warranty    Warranty?

  @@index([variantId, status])
  @@index([branchId])
  @@map("serial_numbers")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?  @db.Text
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  poNumber    String         @unique
  supplierId  String
  branchId    String
  status      PurchaseStatus @default(DRAFT)
  notes       String?        @db.Text
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@index([supplierId, status])
  @@index([branchId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitCost         Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model StockTransfer {
  id            String         @id @default(cuid())
  transferNumber String        @unique
  fromBranchId  String
  toBranchId    String
  status        TransferStatus @default(DRAFT)
  notes         String?        @db.Text
  shippedAt     DateTime?
  receivedAt    DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items      StockTransferItem[]

  @@index([fromBranchId, status])
  @@index([toBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  variantId  String
  quantity   Int

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ---------------------------------------------------------------------------
// Storefront commerce
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("compare_items")
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(12, 2)
  minSubtotal Decimal?   @db.Decimal(12, 2)
  maxUses     Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  orders Order[]

  @@map("coupons")
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  channel         OrderChannel @default(WEB)
  status          OrderStatus  @default(PENDING)
  customerId      String?
  staffId         String?
  branchId        String?
  couponId        String?
  email           String?
  phone           String
  name            String
  shippingAddress Json?
  billingAddress  Json?
  subtotal        Decimal      @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  tax             Decimal      @default(0) @db.Decimal(12, 2)
  shipping        Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  customerNotes   String?      @db.Text
  staffNotes      String?      @db.Text
  placedAt        DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer   User?          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  staff      User?          @relation("StaffOrders", fields: [staffId], references: [id], onDelete: SetNull)
  branch     Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  coupon     Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payments   Payment[]
  statusLogs OrderStatusLog[]
  invoice    Invoice?

  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([phone])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String
  name         String
  sku          String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  tax          Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)
  warrantyMonths Int   @default(0)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  serials SerialNumber[]
  warranties Warranty[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusLog {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

model Payment {
  id            String               @id @default(cuid())
  orderId       String?
  posSaleId     String?
  provider      PaymentProviderType
  amount        Decimal              @db.Decimal(12, 2)
  status        PaymentStatus        @default(PENDING)
  transactionId String?
  payload       Json?
  paidAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  posSale PosSale? @relation(fields: [posSaleId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([posSaleId])
  @@index([transactionId])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String?  @unique
  posSaleId     String?  @unique
  issuedAt      DateTime @default(now())
  pdfUrl        String?  @db.VarChar(500)

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  posSale PosSale? @relation(fields: [posSaleId], references: [id], onDelete: Restrict)

  @@map("invoices")
}

// ---------------------------------------------------------------------------
// POS
// ---------------------------------------------------------------------------

model PosTerminal {
  id        String   @id @default(cuid())
  branchId  String
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessions PosSession[]

  @@index([branchId])
  @@map("pos_terminals")
}

model PosSession {
  id           String           @id @default(cuid())
  terminalId   String
  branchId     String
  cashierId    String
  status       PosSessionStatus @default(OPEN)
  openingFloat Decimal          @default(0) @db.Decimal(12, 2)
  closingCash  Decimal?         @db.Decimal(12, 2)
  notes        String?          @db.Text
  openedAt     DateTime         @default(now())
  closedAt     DateTime?

  terminal PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashier  User        @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  sales    PosSale[]

  @@index([terminalId, status])
  @@index([cashierId, openedAt])
  @@map("pos_sessions")
}

model PosSale {
  id          String        @id @default(cuid())
  saleNumber  String        @unique
  sessionId   String
  branchId    String
  cashierId   String
  customerId  String?
  status      PosSaleStatus @default(COMPLETED)
  subtotal    Decimal       @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  paid        Decimal       @default(0) @db.Decimal(12, 2)
  due         Decimal       @default(0) @db.Decimal(12, 2)
  notes       String?       @db.Text
  soldAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  session  PosSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashier  User          @relation("CashierSales", fields: [cashierId], references: [id], onDelete: Restrict)
  customer User?         @relation("CustomerSales", fields: [customerId], references: [id], onDelete: SetNull)
  items    PosSaleItem[]
  payments PosPayment[]
  returns  PosReturn[]
  invoice  Invoice?
  gatewayPayments Payment[]
  dueEntries DueLedger[]

  @@index([sessionId])
  @@index([branchId, soldAt])
  @@index([customerId])
  @@map("pos_sales")
}

model PosSaleItem {
  id             String  @id @default(cuid())
  saleId         String
  productId      String
  variantId      String
  name           String
  sku            String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  warrantyMonths Int     @default(0)

  sale    PosSale        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  serials SerialNumber[]
  warranties Warranty[]
  returnItems PosReturnItem[]

  @@index([saleId])
  @@map("pos_sale_items")
}

model PosPayment {
  id        String              @id @default(cuid())
  saleId    String
  provider  PaymentProviderType
  amount    Decimal             @db.Decimal(12, 2)
  reference String?
  createdAt DateTime            @default(now())

  sale PosSale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("pos_payments")
}

model PosReturn {
  id             String   @id @default(cuid())
  returnNumber   String   @unique
  originalSaleId String
  reason         String?  @db.Text
  refundAmount   Decimal  @db.Decimal(12, 2)
  createdById    String?
  createdAt      DateTime @default(now())

  originalSale PosSale         @relation(fields: [originalSaleId], references: [id], onDelete: Restrict)
  items        PosReturnItem[]

  @@index([originalSaleId])
  @@map("pos_returns")
}

model PosReturnItem {
  id            String @id @default(cuid())
  returnId      String
  posSaleItemId String
  quantity      Int

  return      PosReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  posSaleItem PosSaleItem @relation(fields: [posSaleItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@map("pos_return_items")
}

model DueLedger {
  id            String       @id @default(cuid())
  customerId    String
  posSaleId     String?
  amount        Decimal      @db.Decimal(12, 2)
  type          DueEntryType
  note          String?
  createdAt     DateTime     @default(now())

  customer User    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  posSale  PosSale? @relation(fields: [posSaleId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("due_ledger")
}

// ---------------------------------------------------------------------------
// Warranties
// ---------------------------------------------------------------------------

model Warranty {
  id          String         @id @default(cuid())
  serialId    String         @unique
  productId   String
  customerId  String?
  orderItemId String?
  posSaleItemId String?
  customerName String?       @db.VarChar(120)
  phone       String?        @db.VarChar(30)
  invoiceRef  String?        @db.VarChar(80)
  startDate   DateTime
  endDate     DateTime
  status      WarrantyStatus @default(ACTIVE)
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  serial      SerialNumber @relation(fields: [serialId], references: [id], onDelete: Restrict)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer    User?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  posSaleItem PosSaleItem? @relation(fields: [posSaleItemId], references: [id], onDelete: SetNull)
  claims      WarrantyClaim[]

  @@index([customerId, status])
  @@index([endDate, status])
  @@index([phone])
  @@map("warranties")
}

model WarrantyClaim {
  id          String               @id @default(cuid())
  warrantyId  String
  description String               @db.Text
  status      WarrantyClaimStatus  @default(OPEN)
  resolution  String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  warranty Warranty @relation(fields: [warrantyId], references: [id], onDelete: Restrict)

  @@index([warrantyId, status])
  @@map("warranty_claims")
}

// ---------------------------------------------------------------------------
// Storefront chrome: menus, homepage, redirects
// ---------------------------------------------------------------------------

model Menu {
  id        String       @id @default(cuid())
  location  MenuLocation @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id         String  @id @default(cuid())
  menuId     String
  parentId   String?
  label      String
  url        String?
  categoryId String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  menu     Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem? @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([menuId, sortOrder])
  @@map("menu_items")
}

model HomepageSection {
  id        String              @id @default(cuid())
  type      HomepageSectionType
  title     String?
  payload   Json
  sortOrder Int                 @default(0)
  isVisible Boolean             @default(true)
  themeId   ThemeId?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([sortOrder])
  @@map("homepage_sections")
}

model UrlRedirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique @db.VarChar(500)
  toPath     String   @db.VarChar(500)
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())

  @@map("url_redirects")
}
