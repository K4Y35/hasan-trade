# Copy to .env. Never commit the real file.

NODE_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=shopstack
MYSQL_USER=shopstack
MYSQL_PASSWORD=shopstack_dev_password
DATABASE_URL=mysql://shopstack:shopstack_dev_password@127.0.0.1:3306/shopstack

# Redis
REDIS_URL=redis://localhost:6379

# Apps
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d

# Seed
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe!123
SEED_DEMO_DATA=true

# Storage: local | minio | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=store
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password
S3_FORCE_PATH_STYLE=true

# Payment secrets — each client supplies their own. Never hardcode.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_SANDBOX=true

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMS_PROVIDER=
SMS_API_KEY=

# Optional license
LICENSE_KEY=
LICENSE_DOMAIN=localhost
