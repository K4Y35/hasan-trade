{
  "name": "shopstack",
  "version": "0.1.0",
  "private": true,
  "description": "ShopStack — white-label e-commerce + POS template.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @shopstack/db generate",
    "db:migrate": "pnpm --filter @shopstack/db migrate",
    "db:migrate:deploy": "pnpm --filter @shopstack/db migrate:deploy",
    "db:seed": "pnpm --filter @shopstack/db seed",
    "db:studio": "pnpm --filter @shopstack/db studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
